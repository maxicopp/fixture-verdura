# Base de datos Turso (producción)
TURSO_DATABASE_URL=libsql://tu-db.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui

# Groq AI (generación de noticias — gratis en groq.com)
GROQ_API_KEY=gsk_tu-key-aqui

# Admin credentials (OBLIGATORIO — la app no arranca sin estos)
ADMIN_USER=
ADMIN_PASS=

# Secret para firmar tokens de sesión (opcional, usa ADMIN_PASS si no se define)
# Recomendado: generar con `openssl rand -hex 32`
ADMIN_SECRET=

# ── Backup automático (Vercel Cron → GitHub Gist) ─────────────────────────────
# Secret para autorizar el endpoint /api/cron/backup (cualquier string aleatorio)
# Recomendado: openssl rand -hex 32
CRON_SECRET=

# GitHub Personal Access Token con scope 'gist' (solo gist, no repo)
# Crear en: https://github.com/settings/tokens/new?scopes=gist
GITHUB_TOKEN=

# ID del Gist donde se guardan los backups
# Crear un gist vacío en https://gist.github.com y copiar el ID de la URL
# Ejemplo URL: https://gist.github.com/usuario/abc123def456  →  GITHUB_GIST_ID=abc123def456
GITHUB_GIST_ID=
